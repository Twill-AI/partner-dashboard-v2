# Copy this file to .dev.vars and fill in your real values.
# .dev.vars is gitignored; wrangler pages dev loads it automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for the private client preview (functions/_middleware.js gate).
# In production this is a Cloudflare Pages secret, NOT committed:
#   echo "<password>" | npx wrangler pages secret put PREVIEW_PASSWORD --project-name partner-dashboard-v2
PREVIEW_PASSWORD=choose-a-shared-password
